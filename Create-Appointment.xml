<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0" xsi:type="MailApp">
  <Id>b7dcd037-f0c9-4431-8851-7f74f5a01ace</Id>
  <Version>1.0.1.0</Version>
  <ProviderName>Email to Appointment</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Create Appointment"/>
  <Description DefaultValue="Copy an email subject and text into a personal appointment draft."/>
  <IconUrl DefaultValue="https://monkeygrind.github.io/outlook-create-appointment-public/appointment-icon-64-v1.png"/>
  <HighResolutionIconUrl DefaultValue="https://monkeygrind.github.io/outlook-create-appointment-public/appointment-icon-80-v1.png"/>
  <SupportUrl DefaultValue="https://monkeygrind.github.io/outlook-create-appointment-public"/>
  <AppDomains><AppDomain>https://monkeygrind.github.io</AppDomain></AppDomains>
  <Hosts><Host Name="Mailbox"/></Hosts>
  <Requirements><Sets><Set Name="Mailbox" MinVersion="1.9"/></Sets></Requirements>
  <FormSettings><Form xsi:type="ItemRead"><DesktopSettings><SourceLocation DefaultValue="https://monkeygrind.github.io/outlook-create-appointment-public/commands.html"/><RequestedHeight>250</RequestedHeight></DesktopSettings></Form></FormSettings>
  <Permissions>ReadItem</Permissions>
  <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements><bt:Sets DefaultMinVersion="1.9"><bt:Set Name="Mailbox"/></bt:Sets></Requirements>
    <Hosts><Host xsi:type="MailHost"><DesktopFormFactor>
      <FunctionFile resid="Commands.Url"/>
      <ExtensionPoint xsi:type="MessageReadCommandSurface"><OfficeTab id="TabDefault"><Group id="Appointment.Group">
        <Label resid="Group.Label"/>
        <Control xsi:type="Button" id="Appointment.Button">
          <Label resid="Button.Label"/>
          <Supertip><Title resid="Button.Label"/><Description resid="Button.Description"/></Supertip>
          <Icon><bt:Image size="16" resid="Icon.16"/><bt:Image size="32" resid="Icon.32"/><bt:Image size="80" resid="Icon.80"/></Icon>
          <Action xsi:type="ExecuteFunction"><FunctionName>createAppointment</FunctionName></Action>
        </Control>
      </Group></OfficeTab></ExtensionPoint>
    </DesktopFormFactor></Host></Hosts>
    <Resources>
      <bt:Images><bt:Image id="Icon.16" DefaultValue="https://monkeygrind.github.io/outlook-create-appointment-public/appointment-icon-16-v1.png"/><bt:Image id="Icon.32" DefaultValue="https://monkeygrind.github.io/outlook-create-appointment-public/appointment-icon-32-v1.png"/><bt:Image id="Icon.80" DefaultValue="https://monkeygrind.github.io/outlook-create-appointment-public/appointment-icon-80-v1.png"/></bt:Images>
      <bt:Urls><bt:Url id="Commands.Url" DefaultValue="https://monkeygrind.github.io/outlook-create-appointment-public/commands.html"/></bt:Urls>
      <bt:ShortStrings><bt:String id="Group.Label" DefaultValue="Personal calendar"/><bt:String id="Button.Label" DefaultValue="Create Appointment"/></bt:ShortStrings>
      <bt:LongStrings><bt:String id="Button.Description" DefaultValue="Open an appointment with this email's subject and text, with no attendees."/></bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
